-- [[ BUTTON CREATOR ]] --
local function AddButton(name, settingKey, isColorSwitcher)
	local Btn = Instance.new("TextButton")
	local BtnCorner = Instance.new("UICorner")
	local BtnStroke = Instance.new("UIStroke")
	
	Btn.Parent = Holder
	Btn.Size = UDim2.new(1, 0, 0, 42)
	Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	Btn.Text = isColorSwitcher and "CHANGE COLOR" or (name .. ": OFF")
	Btn.Font = Enum.Font.GothamSemibold
	Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
	Btn.TextSize = 13
	Btn.AutoButtonColor = false
	
	BtnCorner.CornerRadius = UDim.new(0, 10)
	BtnCorner.Parent = Btn
	BtnStroke.Color = Color3.fromRGB(60, 60, 75)
	BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	BtnStroke.Parent = Btn

	Btn.MouseButton1Click:Connect(function()
		if isColorSwitcher then
			Settings.CurrentColorIndex = Settings.CurrentColorIndex % #Settings.ESPColors + 1
			local newCol = Settings.ESPColors[Settings.CurrentColorIndex]
			Settings.AccentColor = newCol
			TweenService:Create(UIStroke, TweenInfo.new(0.3), {Color = newCol}):Play()
			TweenService:Create(Title, TweenInfo.new(0.3), {TextColor3 = newCol}):Play()
			for _, p in pairs(Players:GetPlayers()) do
				if p.Character and p.Character:FindFirstChild("AdminHighlight") then
					p.Character.AdminHighlight.FillColor = newCol
				end
			end
		else
			Settings[settingKey] = not Settings[settingKey]
			Btn.Text = name .. (Settings[settingKey] and ": ON" or ": OFF")
			local targetCol = Settings[settingKey] and Color3.fromRGB(0, 80, 80) or Color3.fromRGB(30, 30, 40)
			TweenService:Create(Btn, TweenInfo.new(0.3), {BackgroundColor3 = targetCol}):Play()
			
			if settingKey == "ESP" then
				for _, p in pairs(Players:GetPlayers()) do
					if p.Character and p.Character:FindFirstChild("AdminHighlight") then
						p.Character.AdminHighlight.Enabled = Settings.ESP
					end
				end
			end
		end
	end)
end

