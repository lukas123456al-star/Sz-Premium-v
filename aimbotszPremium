-- [[ CORE LOGIC: AIMBOT ]] --
RunService.RenderStepped:Connect(function()
	if Settings.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local target, closestDist = nil, Settings.FOV
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
				local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
				if onScreen then
					local mag = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
					if mag < closestDist then
						target = p
						closestDist = mag
					end
				end
			end
		end
		
		if target and target.Character then
			local predictedPos = target.Character.Head.Position + (target.Character.HumanoidRootPart.Velocity * Settings.Prediction)
			Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, predictedPos), Settings.Smoothing)
		end
	end
end)

-- [[ CORE LOGIC: MOVEMENT & ANTI-AIM ]] --
local t = 0
RunService.Heartbeat:Connect(function(dt)
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = LocalPlayer.Character.HumanoidRootPart
		local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
		
		if Settings.Dodge and hum and hum.MoveDirection.Magnitude > 0 then
			t = t + dt * 12
			local sway = Vector3.new(math.sin(t) * 1.5, 0, math.cos(t) * 1.5)
			hum:Move(hum.MoveDirection + sway, false)
		end
		
		if Settings.AntiAim then
			local jitter = math.random(-10, 10) / 100
			hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(60), 0) * CFrame.new(jitter, 0, jitter)
		end
	end
end)

-- [[ CORE LOGIC: PERSISTENT ESP (FIXED) ]] --
local function CreateESP(p)
	local function setup(char)
		-- Sicherstellen, dass das Highlight nicht mehrfach existiert
		local old = char:FindFirstChild("AdminHighlight")
		if old then old:Destroy() end
		
		-- Warten bis Charakter bereit ist
		task.wait(0.1)
		
		local h = Instance.new("Highlight")
		h.Name = "AdminHighlight"
		h.FillColor = Settings.AccentColor
		h.OutlineColor = Color3.new(1,1,1)
		h.FillTransparency = 0.5
		h.Enabled = Settings.ESP
		h.Parent = char
	end
	
	p.CharacterAdded:Connect(setup)
	if p.Character then setup(p.Character) end
end

Players.PlayerAdded:Connect(CreateESP)
for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then CreateESP(p) end end

